# Copy this file to .env and edit it. .env stays on your server and is not committed.

# Minecraft usernames the panel may control, comma-separated.
PLAYERS=player_one,player_two

# Name of your itzg/minecraft-server container (`docker ps` shows it).
MC_CONTAINER=minecraft

# Port to open the panel on.
PANEL_PORT=8080

# Optional password. Leave empty on a trusted home network; if set, the
# browser asks for it once and remembers it.
API_TOKEN=

# Optional: port of a squaremap live map on the same host (see README).
# Leave empty to hide the map buttons.
MAP_PORT=
